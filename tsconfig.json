{
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "obsidian": ["node_modules/obsidian"]
    },
    "target": "es2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["dom", "es2020"],
    "allowJs": false,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "useDefineForClassFields": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
